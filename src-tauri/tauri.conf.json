{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slacking Desk",
  "version": "0.2.0",
  "identifier": "com.privatevoidyou.slackingdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slacking Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost plugin: http://plugin.localhost appfile: http://appfile.localhost; style-src 'self' 'unsafe-inline'; frame-src plugin: http://plugin.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
