{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "壳主窗口的能力。插件窗口不会获得这些能力。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "allow-app-info",
    "allow-open-data-dir",
    "allow-get-settings",
    "allow-save-settings",
    "allow-plugins-list",
    "allow-plugin-pick-folder",
    "allow-plugin-add",
    "allow-plugin-set-enabled",
    "allow-plugin-reload",
    "allow-plugin-restart",
    "allow-plugin-remove",
    "allow-plugin-open",
    "allow-plugin-open-log",
    "allow-plugin-devtools"
  ]
}
